NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only HMAC key used to derive each child's Supabase password from
# their child id. Generate with: openssl rand -base64 48
# Rotating it invalidates every child login (parents must re-issue invite codes).
CHILD_AUTH_SECRET=

# Web Push (VAPID). Generated locally, nothing to do with Supabase:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
# The public key ships to the browser; the private key never leaves the server.
# Changing them invalidates every existing push subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
